---
import { cva, type VariantProps } from "class-variance-authority";

const asideVariants = cva(
	[
		"my-4",
		"rounded-r",
		"border-l-2",
		"border-l-(--aside-color)",
		"bg-(--aside-color)/5",
		"p-4",
		"italic",
		"relative",
		"[&_p:only-child]:m-0",
	],
	{
		variants: {
			variant: {
				primary: "[--aside-color:var(--color-primary)]",
				default: "[--aside-color:var(--color-primary)]",
				info: [
					"[--aside-color:var(--color-info)]",
					"before:inline-flex",
					"before:items-center",
					"before:justify-center",
					"before:rounded-full",
					"before:content-['i']",
				],
				danger: [
					"[--aside-color:var(--color-danger)]",
					"before:grid",
					"before:items-end",
					"before:justify-center",
					"before:content-['!']",
					"before:[clip-path:polygon(50%_0,0_100%,100%_100%)]",
				],
				success: [
					"[--aside-color:var(--color-success)]",
					"before:inline-flex",
					"before:items-center",
					"before:justify-center",
					"before:rounded-full",
					"before:content-checkmark",
				],
			},
		},
		compoundVariants: [
			{
				variant: ["info", "danger", "success"],
				class: [
					"before:absolute",
					"before:left-0",
					"before:top-0",
					"before:h-[35px]",
					"before:w-[35px]",
					"before:-translate-x-1/2",
					"before:-translate-y-1/2",
					"before:bg-(--aside-color)",
					"before:font-bold",
					"before:not-italic",
					"before:text-background",
					"before:text-xl",
				],
			},
		],
		defaultVariants: {
			variant: "default",
		},
	},
);

type Props = VariantProps<typeof asideVariants>;

const { variant = "default" } = Astro.props;
---

<aside class={asideVariants({ variant })}>
	<slot />
</aside>
